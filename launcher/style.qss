QWidget {

    background-color: #1e1e1e;

    color: #ffffff;

    font-family: Segoe UI;

    font-size: 14px;
}


/* ---------- GROUP BOX ---------- */

QGroupBox {

    border: 1px solid #444;

    border-radius: 8px;

    margin-top: 10px;

    padding: 10px;

}


QGroupBox::title {

    color: #4da3ff;

    padding: 0 5px;

}


/* ---------- BUTTONS ---------- */

QPushButton {

    background-color: #2d6cdf;

    color: white;

    border: none;

    border-radius: 6px;

    padding: 8px 16px;

}


QPushButton:hover {

    background-color: #3d7df5;

}


QPushButton:pressed {

    background-color: #1f4ea8;

}


/* ---------- TEXT ---------- */

QTextEdit {

    background-color: #111;

    color: #00ff90;

    border-radius: 5px;

    font-family: Consolas;

}


/* ---------- TABS ---------- */

QTabWidget::pane {

    border: 1px solid #444;

    background-color: #1e1e1e;

    border-radius: 6px;

}


QTabBar::tab {

    background-color: #2a2a2a;

    color: #bbbbbb;

    padding: 10px 30px;

    border: 1px solid #444;

    border-bottom: none;

    border-top-left-radius: 6px;

    border-top-right-radius: 6px;

    min-width: 120px;

}


QTabBar::tab:hover {

    background-color: #3a3a3a;

    color: white;

}


QTabBar::tab:selected {

    background-color: #2d6cdf;

    color: white;

    font-weight: bold;

}


/* ---------- DASHBOARD CARDS ---------- */

#StatCard {

    background-color: #20242b;

    border: 1px solid #333;

    border-radius: 12px;

    padding: 15px;

    min-width: 180px;

}


#StatValue {

    font-size: 28px;

    font-weight: bold;

    color: #00ff88;

}


/* ---------- TREE VIEW ---------- */

QTreeWidget {

    background-color: #151515;

    alternate-background-color: #1c1c1c;

    border: 1px solid #333;

    border-radius: 8px;

    padding: 5px;

}


QTreeWidget::item {

    padding: 5px;

}


QTreeWidget::item:hover {

    background-color: #2a3b55;

}


QTreeWidget::item:selected {

    background-color: #2d6cdf;

    color: white;

}


QHeaderView::section {

    background-color: #252525;

    color: #4da3ff;

    padding: 8px;

    border: none;

    font-weight: bold;

}


/* ---------- LABELS ---------- */

QLabel {

    color: #ffffff;

}


#DashboardTitle {

    font-size: 24px;

    font-weight: bold;

    color: #4da3ff;

}